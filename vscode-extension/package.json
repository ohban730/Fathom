{
  "name": "dedoubt-vscode",
  "displayName": "DeDoubt — コード理解サポート",
  "description": "バイブコーディングの理解負債を解消し、IDE内で直感的にコード理解度を学習・検証するVS Code拡張機能",
  "version": "2.0.0",
  "publisher": "dedoubt",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onCommand:dedoubt.startSession",
    "onView:dedoubt.panelView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dedoubt.startSession",
        "title": "DeDoubt: 理解度テストを開始 (現在のファイル)",
        "icon": "$(brain)"
      }
    ],
    "keybindings": [
      {
        "command": "dedoubt.startSession",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "dedoubtPanelContainer",
          "title": "DeDoubt",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dedoubtPanelContainer": [
        {
          "type": "webview",
          "id": "dedoubt.panelView",
          "name": "DeDoubt"
        }
      ]
    },
    "configuration": {
      "title": "DeDoubt",
      "properties": {
        "dedoubt.pythonPath": {
          "type": "string",
          "default": "",
          "description": "DeDoubtバックエンド(main.py)を起動するPython実行体の絶対パス(例: condaのdedoubt環境のpython.exe)。未設定の場合はバックエンドを起動できません。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.x",
    "typescript": "^5.0.0"
  }
}
