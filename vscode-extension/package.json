{
  "name": "codelitmus-vscode",
  "displayName": "CodeLitmus — コード理解サポート",
  "description": "バイブコーディングの理解負債を解消し、IDE内で直感的にコード理解度を学習・検証するVS Code拡張機能",
  "version": "2.0.0",
  "publisher": "codelitmus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohban730/CodeLitmus.git"
  },
  "bugs": {
    "url": "https://github.com/ohban730/CodeLitmus/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onCommand:codelitmus.startSession",
    "onCommand:codelitmus.showRecentFiles",
    "onView:codelitmus.panelView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codelitmus.startSession",
        "title": "CodeLitmus: 理解度テストを開始 (現在のファイル)",
        "icon": "$(brain)"
      },
      {
        "command": "codelitmus.showRecentFiles",
        "title": "CodeLitmus: 最近テストしたファイルを開く",
        "icon": "$(history)"
      }
    ],
    "keybindings": [
      {
        "command": "codelitmus.startSession",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "codelitmusPanelContainer",
          "title": "CodeLitmus",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codelitmusPanelContainer": [
        {
          "type": "webview",
          "id": "codelitmus.panelView",
          "name": "CodeLitmus"
        }
      ]
    },
    "configuration": {
      "title": "CodeLitmus",
      "properties": {
        "codelitmus.pythonPath": {
          "type": "string",
          "default": "",
          "description": "CodeLitmusバックエンド(main.py)を起動するPython実行体の絶対パス(例: condaのcodelitmus環境のpython.exe)。未設定の場合はバックエンドを起動できません。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.x",
    "typescript": "^5.0.0"
  }
}
