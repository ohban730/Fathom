{
  "name": "codelitmus-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "2.0.0",
  "publisher": "codelitmus",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohban730/CodeLitmus.git"
  },
  "bugs": {
    "url": "https://github.com/ohban730/CodeLitmus/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onCommand:codelitmus.startSession",
    "onCommand:codelitmus.showRecentFiles",
    "onView:codelitmus.panelView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codelitmus.startSession",
        "title": "%command.startSession.title%",
        "icon": "$(brain)"
      },
      {
        "command": "codelitmus.showRecentFiles",
        "title": "%command.showRecentFiles.title%",
        "icon": "$(history)"
      }
    ],
    "keybindings": [
      {
        "command": "codelitmus.startSession",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "codelitmusPanelContainer",
          "title": "CodeLitmus",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codelitmusPanelContainer": [
        {
          "type": "webview",
          "id": "codelitmus.panelView",
          "name": "CodeLitmus"
        }
      ]
    },
    "configuration": {
      "title": "CodeLitmus",
      "properties": {
        "codelitmus.pythonPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.pythonPath.description%"
        },
        "codelitmus.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "%configuration.ollamaModel.description%"
        },
        "codelitmus.outputLanguage": {
          "type": "string",
          "enum": [
            "ja",
            "en"
          ],
          "enumDescriptions": [
            "%configuration.outputLanguage.ja%",
            "%configuration.outputLanguage.en%"
          ],
          "default": "ja",
          "description": "%configuration.outputLanguage.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:css && npm run compile",
    "build:css": "tailwindcss -c tailwind.config.js -i src/webview/tailwind.src.css -o media/vendor/tailwind.css --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0"
  }
}
